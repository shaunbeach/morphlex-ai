{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Morphlex AI Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/hands"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/hands/out/**/*.js"
      ],
      "preLaunchTask": "${defaultBuildTask}"
    }
  ]
}
